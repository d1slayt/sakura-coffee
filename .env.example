# PostgreSQL connection string used by Prisma (migrations, seed) and the app.
# Local Docker example:
#   DATABASE_URL="postgresql://sakura:sakura@localhost:5432/sakura_coffee?schema=public"
# Zero-install local option: run `npx prisma dev` and paste the postgres:// URL it prints.
DATABASE_URL="postgresql://sakura:sakura@localhost:5432/sakura_coffee?schema=public"

# Optional connection pool size. Set to 1 when using `npx prisma dev` (PGlite runs
# all connections in a single Postgres session). Leave unset for a real PostgreSQL server.
# DATABASE_POOL_MAX=1

# Secret used to hash client IPs for rate limiting (never store raw IPs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT="change-me-to-a-long-random-string"

# Public origin used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
